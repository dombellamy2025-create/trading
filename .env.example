# Copy to .env (which is git-ignored). Get keys at https://app.alpaca.markets  (Paper Trading -> API Keys)
ALPACA_API_KEY=your_paper_trading_key
ALPACA_SECRET_KEY=your_paper_trading_secret
# Paper account. For real money use https://api.alpaca.markets AND start with --live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data feed for stocks/ETFs: iex (free) or sip (paid subscription)
STOCK_DATA_FEED=iex

# --- Strategy options (strategy parameters themselves live in config.py) ---
# ALLOW_SHORT=true        # shorts for SPY/QQQ/GLD/USO (BTC can never be shorted on Alpaca)
# MR_STOP_STD=0           # optional mean-reversion stop in std-devs from the SMA, e.g. 3.0; 0 = off

# --- Risk (defaults shown) ---
# ATR_PERIOD=14
# SIZING_ATR_TIMEFRAME=daily  # daily = 14-day ATR; strategy = 14 bars of the strategy's own timeframe
# RISK_PER_TRADE=0.01         # position sized so a 1-ATR adverse move = 1% of equity
# HARD_STOP_PCT=0.01          # every position: broker stop + software stop at a 1%-of-equity loss
# MAX_ALLOC_PER_SYMBOL=1.0    # max notional per instrument, as a multiple of equity
# MAX_GROSS_EXPOSURE=2.0      # max total notional across all positions (2.0 = 2x leverage)
# MAX_DAILY_LOSS=0.03         # flatten everything & halt for the day past this drawdown
# FRACTIONAL_SHARES=false     # fractional ETF longs (shorts are always whole shares)

# --- Runtime / output ---
# LOOP_SECONDS=30             # how often stops & exits are checked (signals run once per strategy bar)
# BAR_DELAY_SECONDS=15        # wait after a bar closes before fetching it
# TRADES_CSV=trades.csv
# DAILY_PNL_CSV=daily_pnl.csv

# --- Morning briefing (python -m bot.briefing) ---
# Create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
